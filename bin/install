#!/usr/bin/env bash
set -e

# Install oma12c into the Omarchy environment.
# Builds the application and copies the binary into ~/.local/bin.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_DIR/build"
INSTALL_DIR="${INSTALL_DIR:-$HOME/.local/bin}"

if command -v qmake6 >/dev/null 2>&1; then
    QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
    QMAKE=qmake
else
    echo "A Qt 6 qmake (qmake6) is required to build oma12c." >&2
    exit 1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$PROJECT_DIR/oma12c.pro"
make -j"$(nproc)"

mkdir -p "$INSTALL_DIR"
cp "$BUILD_DIR/oma12c" "$INSTALL_DIR/oma12c"

# Configure Omarchy (Hyprland) to float and center oma12c on launch.
HYPR_FILE="$HOME/.config/hypr/hyprland.lua"
if [ -f "$HYPR_FILE" ]; then
    if ! grep -q 'o.window("oma12c"' "$HYPR_FILE"; then
        echo 'o.window("oma12c", { float = true, center = true, size = { 900, 600 } })' >> "$HYPR_FILE"
        echo "Added Omarchy window rule to $HYPR_FILE"
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl reload >/dev/null 2>&1 || true
        fi
    else
        echo "Omarchy window rule already exists in $HYPR_FILE"
    fi
fi

echo "oma12c installed to $INSTALL_DIR/oma12c"
