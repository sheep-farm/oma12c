#!/usr/bin/env bash
set -e

# Install or uninstall oma12c in the Omarchy environment.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_DIR/build"
INSTALL_DIR="${INSTALL_DIR:-$HOME/.local/bin}"

uninstall() {
    echo "Uninstalling oma12c..."

    if [ -f "$INSTALL_DIR/oma12c" ]; then
        rm "$INSTALL_DIR/oma12c"
        echo "Removed $INSTALL_DIR/oma12c"
    fi

    HYPR_FILE="$HOME/.config/hypr/hyprland.lua"
    if [ -f "$HYPR_FILE" ]; then
        if grep -q 'o.window("oma12c"' "$HYPR_FILE"; then
            grep -v 'o.window("oma12c"' "$HYPR_FILE" > "$HYPR_FILE.tmp" && mv "$HYPR_FILE.tmp" "$HYPR_FILE"
            echo "Removed Omarchy window rule from $HYPR_FILE"
            if command -v hyprctl >/dev/null 2>&1; then
                hyprctl reload >/dev/null 2>&1 || true
            fi
        fi
    fi

    if [ -d "$BUILD_DIR" ]; then
        rm -rf "$BUILD_DIR"
        echo "Removed $BUILD_DIR"
    fi

    echo "oma12c uninstalled."
}

install() {
    if command -v qmake6 >/dev/null 2>&1; then
        QMAKE=qmake6
    elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
        QMAKE=qmake
    else
        echo "A Qt 6 qmake (qmake6) is required to build oma12c." >&2
        exit 1
    fi

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    "$QMAKE" "$PROJECT_DIR/oma12c.pro"
    make -j"$(nproc)"

    mkdir -p "$INSTALL_DIR"
    cp "$BUILD_DIR/oma12c" "$INSTALL_DIR/oma12c"

    # Configure Omarchy (Hyprland) to float and center oma12c on launch.
    HYPR_FILE="$HOME/.config/hypr/hyprland.lua"
    if [ -f "$HYPR_FILE" ]; then
        RULE='o.window("oma12c", { float = true, center = true, size = { 1100, 650 } })'
        if grep -q 'o.window("oma12c"' "$HYPR_FILE"; then
            sed -i "/o.window(\"oma12c\"/c\\$RULE" "$HYPR_FILE"
            echo "Updated Omarchy window rule in $HYPR_FILE"
        else
            echo "$RULE" >> "$HYPR_FILE"
            echo "Added Omarchy window rule to $HYPR_FILE"
        fi
        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl reload >/dev/null 2>&1 || true
        fi
    fi

    echo "oma12c installed to $INSTALL_DIR/oma12c"
}

case "${1:-install}" in
    install|--install|''|-i)
        install
        ;;
    uninstall|--uninstall|-u)
        uninstall
        ;;
    *)
        echo "Usage: $0 [install|uninstall]" >&2
        exit 1
        ;;
esac
